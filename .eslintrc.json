{
  "extends": [
    "next/core-web-vitals",
    "airbnb",
    "eslint:recommended",
    "airbnb-typescript",
    "plugin:@typescript-eslint/recommended",
    "plugin:@typescript-eslint/recommended-requiring-type-checking",
    "plugin:prettier/recommended",
    "plugin:import/typescript",
    "plugin:storybook/recommended"
  ],
  "ignorePatterns": [
    "node_modules/*",
    ".next/*",
    "next.config.mjs",
    "postcss.config.mjs",
    "tailwind.config.mjs"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": "latest",
    "project": "./tsconfig.json",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint", "prettier", "import", "react", "storybook"],
  "root": true,
  "rules": {
    "default-case": "off",
    "import/order": [
      "error",
      {
        "alphabetize": {
          "caseInsensitive": true,
          "order": "asc"
        },
        "groups": [
          "builtin",
          "external",
          "internal",
          "parent",
          "sibling",
          "index"
        ],
        "newlines-between": "always",
        "pathGroups": [
          {
            "group": "builtin",
            "pattern": "{next,next/**}",
            "position": "before"
          },
          {
            "group": "builtin",
            "pattern": "react",
            "position": "before"
          },
          {
            "group": "internal",
            "pattern": "{~/forms/**,~/forms}",
            "position": "before"
          },
          {
            "group": "internal",
            "pattern": "{~/components/**,~/components}",
            "position": "before"
          },
          {
            "group": "internal",
            "pattern": "{~/hooks/**,~/hooks}",
            "position": "after"
          },
          {
            "group": "internal",
            "pattern": "{~/i18n,~/middleware,~/navigation,~/prisma}",
            "position": "before"
          },
          {
            "group": "internal",
            "pattern": "{~/utils/**,~/utils}",
            "position": "after"
          },
          {
            "group": "internal",
            "pattern": "{~/styles/**,~/styles}",
            "position": "after"
          },
          {
            "group": "internal",
            "pattern": "{~/assets/**,~/assets}",
            "position": "after"
          }
        ],
        "pathGroupsExcludedImportTypes": ["react"],
        "warnOnUnassignedImports": false
      }
    ],
    "import/prefer-default-export": "off",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "no-void": "off",
    "prettier/prettier": [
      "error",
      {
        "arrowParens": "avoid",
        "bracketSameLine": false,
        "endOfLine": "lf",
        "indentStyle": "space",
        "jsxSingleQuote": true,
        "printWidth": 80,
        "semi": false,
        "singleQuote": true,
        "tabWidth": 2,
        "trailingComma": "all",
        "useTabs": false
      }
    ],
    "react/prop-types": "off",
    "react/react-in-jsx-scope": "off",
    "react/require-default-props": "off",
    "sort-imports": [
      "error",
      {
        "allowSeparatedGroups": true,
        "ignoreDeclarationSort": true
      }
    ]
  },
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [".ts", ".tsx"]
      },
      "typescript": {}
    },
    "react": {
      "version": "detect"
    }
  }
}
